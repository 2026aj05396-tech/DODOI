# Copy to .env.local and fill in values. Never commit real secrets.
# Every variable is validated at startup in src/server/lib/env.ts.

# local | test | production (SYSTEM_ARCHITECTURE §13)
APP_ENV="local"

# PostgreSQL (docker compose service "db", host port 5433)
DATABASE_URL="postgresql://dodoi:dodoi@localhost:5433/dodoi?schema=public"
