# ⚠  TEMPLATE ONLY — this file is committed to git. NEVER put real keys or secrets here.
#    Copy it to .env.local (git-ignored) and fill in your real values THERE:
#        cp .env.example .env.local
#    A test (src/server/lib/env-example.test.ts) fails if anything secret-looking appears below.
# Each environment (local, test, production) has its own values (SYSTEM_ARCHITECTURE §13).
# Variables are validated at server startup in src/server/lib/env.ts.

# --- Required now -------------------------------------------------------------

# local | test | production
APP_ENV="local"

# PostgreSQL (docker compose service "db", host port 5433)
DATABASE_URL="postgresql://dodoi:dodoi@localhost:5433/dodoi?schema=public"

# Auth.js — required. Uncomment these in .env.local and fill them in.
# Generate the secret with `npx auth secret` (at least 32 characters).
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"
# Google OAuth client (redirect URI: <AUTH_URL>/api/auth/callback/google)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Optional: this email becomes ADMIN after its first sign-in with a verified email
# SEED_ADMIN_EMAIL=""

# --- Added by later tasks (not validated yet) ---------------------------------

# Resend email (P1-05)
# RESEND_API_KEY=""
# EMAIL_FROM=""

# Cloudinary media (P1-03) — server only
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Public base URL used in client code (first client use)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
