# ⚠  TEMPLATE ONLY — this file is committed to git. NEVER put real keys or secrets here.
#    Copy it to .env.local (git-ignored) and fill in your real values THERE:
#        cp .env.example .env.local
#    A test (src/server/lib/env-example.test.ts) fails if anything secret-looking appears below.
# Each environment (local, test, production) has its own values (SYSTEM_ARCHITECTURE §13).
# Variables are validated at server startup in src/server/lib/env.ts.

# --- Required now -------------------------------------------------------------

# local | test | production
APP_ENV="local"

# PostgreSQL (docker compose service "db", host port 5433)
DATABASE_URL="postgresql://dodoi:dodoi@localhost:5433/dodoi?schema=public"
# Hosted only (Neon): the direct, unpooled URL, used by `prisma migrate`. Leave unset locally.
# DIRECT_DATABASE_URL=""

# Auth.js — required. Uncomment these in .env.local and fill them in.
# Generate the secret with `npx auth secret` (at least 32 characters).
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"
# Google OAuth client (redirect URI: <AUTH_URL>/api/auth/callback/google)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Automated tests only (APP_ENV=local): points Google sign-in at a local mock. Leave unset.
# AUTH_GOOGLE_ISSUER=""

# Optional: this email becomes ADMIN after its first sign-in with a verified email
# SEED_ADMIN_EMAIL=""
# Optional: support address shown on profiles hidden after a report (set before launch).
# SUPPORT_EMAIL=""

# Resend email — required (the key may stay empty only for automated local test runs,
# which then skip sending, or when SMTP is set). Until a domain is verified, Resend only delivers
# to your own address.
# RESEND_API_KEY=""
# EMAIL_FROM="dodoi <onboarding@resend.dev>"
# SMTP instead of Resend (used when both are set), e.g. a Gmail account with an App Password;
# EMAIL_FROM must then be that address. Port 465 (TLS).
# SMTP_HOST="smtp.gmail.com"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Cloudinary media — required, server only. Uploads go to dodoi/<APP_ENV>/… in this cloud.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Hosted environments only (test, production): Vercel Cron sends it to /api/cron/daily.
# At least 32 random characters, e.g. `openssl rand -base64 32`. Leave unset locally.
# CRON_SECRET=""

# Automated tests only (APP_ENV=local): points Cloudinary's Admin API at a local mock. Leave unset.
# CLOUDINARY_API_BASE=""

# AI companion (Phase 4) — off by default. When AI_ENABLED is "true", GEMINI_API_KEY and AI_MODEL are
# required. AI_TIER "free" (Google AI Studio's free quota) lets Google use and review what is sent:
# allowed for local and test (testers are told); production needs AI_TIER "paid" (billing enabled). Prices are US dollars per million tokens, for the usage dashboard's estimate.
# AI_ENABLED="false"
# AI_PROVIDER="gemini"
# AI_MODEL=""
# AI_TIER="free"
# GEMINI_API_KEY=""
# AI_DAILY_REQUEST_CAP="500"
# AI_INPUT_PRICE_PER_M="0"
# AI_OUTPUT_PRICE_PER_M="0"

# --- Added by later tasks (not validated yet) ---------------------------------

# Public base URL used in client code (first client use)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
